# Caldriva Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SITE_URL=http://localhost:3000

# Geoapify Geocoding API (required for address autocomplete)
# Get your API key from https://www.geoapify.com/get-started-with-maps-api
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Test credentials for live Supabase verification (optional)
# SUPABASE_TEST_USER_A_EMAIL=testa@example.com
# SUPABASE_TEST_USER_A_PASSWORD=password_a
# SUPABASE_TEST_USER_B_EMAIL=testb@example.com
# SUPABASE_TEST_USER_B_PASSWORD=password_b